# Application
APP_NAME=ComplaintMe AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=complaintme
POSTGRES_PASSWORD=complaintme
POSTGRES_DB=complaintme

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Cortexa understanding engine (AI provider). "heuristic" = dependency-free V1.
CORTEXA_PROVIDER=heuristic

